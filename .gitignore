# ── Project memory: MUST NOT be published ──────────────────────────
# .brain/ lives one level up (outside this repo) by design. This entry is a
# defensive guard in case anyone copies it in. It contains candid grading-risk
# notes that must not appear on a public repo before marking.
.brain/

# ── Environments ───────────────────────────────────────────────────
.venv/
venv/
aml-venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# ── Derived data (regenerate with scripts/01_build_corpus.py) ──────
# The FROZEN corpus in data/processed/ IS committed — it is the exact input to
# every experiment and is required for reproducibility (marking criterion 5.1).
# Bulky intermediates are not.
data/interim/*
!data/interim/.gitkeep
data/processed/*.pkl
data/processed/*.npy
data/processed/*.npz
data/processed/dictionary*
data/processed/bow*
data/processed/tfidf*
!data/processed/.gitkeep

# ── Experiment outputs ─────────────────────────────────────────────
# Metrics/config per run ARE committed (evidence of running the experiments,
# marking criterion 2.4). Model binaries are not.
results/runs/**/*.model
results/runs/**/*.bin
results/runs/**/*.pkl
results/runs/**/*.safetensors
results/**/embeddings*

# ── Caches ─────────────────────────────────────────────────────────
.pytest_cache/
.ipynb_checkpoints/
nltk_data/
.cache/
*.log

# ── Editors / OS ───────────────────────────────────────────────────
.vscode/
.idea/
.cursor/
*.swp
Thumbs.db
desktop.ini
.DS_Store
